# Copy to .env (never commit secrets).
#   cp deploy/compose/.env.example deploy/compose/.env
#   docker compose -f deploy/compose/docker-compose.yml --env-file deploy/compose/.env up -d

POSTGRES_USER=factory
POSTGRES_PASSWORD=factory
POSTGRES_DB=factory
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=factory
MINIO_ROOT_PASSWORD=factorysecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8080
GATEWAY_PORT=8081
CONSOLE_PORT=5173

DEV_TENANT_ID=dev-tenant
BRAND_NAME=Agent 工厂
BRAND_LOGO=
THEME_COLOR=#1677ff

# Demo chase interval (production: 24h). Used by API chaser.
DEMO_CHASE_AFTER=30s
CHASE_TICK=5s

# Browser-facing URLs baked into the console image (profile app).
PUBLIC_API_BASE=http://localhost:8080
PUBLIC_GATEWAY_BASE=http://localhost:8081

# --- P1 engines (not started by default) ---
# docker compose --profile engines up -d
# Coze Studio / RAGFlow are multi-container stacks; do not pin unverified
# images here. See deploy/compose/README.md.
# Activepieces: MIT community core only — never packages/ee.
