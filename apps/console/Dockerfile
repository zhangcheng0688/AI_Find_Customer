FROM node:22-alpine AS build
WORKDIR /src
COPY package.json ./
RUN npm install
COPY . .
ARG VITE_API_BASE=http://localhost:8080
ARG VITE_GATEWAY_BASE=http://localhost:8081
ARG VITE_TENANT_ID=dev-tenant
ARG VITE_BRAND_NAME=Agent 工厂
ARG VITE_BRAND_LOGO=
ARG VITE_THEME_COLOR=#1677ff
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_GATEWAY_BASE=$VITE_GATEWAY_BASE
ENV VITE_TENANT_ID=$VITE_TENANT_ID
ENV VITE_BRAND_NAME=$VITE_BRAND_NAME
ENV VITE_BRAND_LOGO=$VITE_BRAND_LOGO
ENV VITE_THEME_COLOR=$VITE_THEME_COLOR
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /src/dist /usr/share/nginx/html
EXPOSE 80
